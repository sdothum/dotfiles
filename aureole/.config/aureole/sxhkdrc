super + shift + space
	menu

super + apostrophe
	winid=$(pfw) menu shortcuts

super + shift + apostrophe ; {super + shift + apostrophe,w,n,d,D}
	winid=$(pfw) menu {wikis,wikis,notes,notes diary,notes draft}

super + shift + a
	menu reminder

super + {_,shift} + o
	menu {scripts,projects}

super + shift + p ; {p,P}
	{menu passwords,eval $TAPDANCE}

super + shift + v
	menu media

# ........................................................................ terms

# NOTE: a macro may only define a single matching {selection} list

super + {_,shift} + Return
	scratchpad={scratchy,itchy} ;\
	aether window toggle --name $scratchpad || tmux session $scratchpad

super + ctrl + Return
	term

alt + super + Return
	term_geometry ;\
	aether state snapshot . window size terminal . window snap center vertical . state restore

# ....................................................................... system

# NOTE: super + shift + colon == super + colon

super + colon
	menu system

super + ctrl + colon
	aether window toggle btop || term btop class=btop BLACKBOARD btop

# ........................................................................ music

# NOTE: switch out to DESK group after hiding app to avoid attaching new windows to app group

super + j
	piano stop ;\
	aether window toggle music && exit || music

super + ctrl + j
	mpc toggle ;\
	mpc | grep -q playing && \{ piano stop; mpc:settings volume; mpc:settings; \}

super + shift + {comma,period}
	mpc {prev,next} ;\
	mpc:settings

super + {_,ctrl} + k
	piano {toggle || piano,stop}

# super + ctrl + k
# 	piano stop

# ................................................................. audio volume

super + {comma,period}
	audio_volume mpc   ;\
	mpc volume {-5,+5} ;\
	mpc:settings volume

super + ctrl + {comma,period}
	audio_volume pactl                             ;\
	pactl set-sink-volume @DEFAULT_SINK@ {-5%,+5%} ;\
	wp:volume clear

alt + ctrl + super + j
	pactl set-sink-mute @DEFAULT_SINK@ toggle

# ......................................................................... http

# NOTE: {super + b} for sloppy trigger :-)

super + b ; {super + b,b,c,f,y}
	{qutebrowser,qutebrowser,chromium,firefox,qutebrowser https://www.youtube.com/}

super + ctrl + b
	qutebrowser closeall

super + shift + b
	aether layouts fold 3 qutebrowser

super + h
	aether window toggle Luakit && exit || hangouts

super + shift + h
	aether window toggle halloy || halloy

# NOTE: nicotine (direct gui -- not docker browser) leaves dangling child aether window frames SEE: winids

super + shift + j
	aether window toggle --name nicotine || nicotine

# ......................................................................... yazi

