# ...................................................................... viewers

# HACK: for yazi photo display requires initial delay to prevent triggering "menu" from sxhkd "toggle wallpaper"

class="feh"
	sleep 0.25                         ;\
	xdotool key space                  ;\
	sleep 0.1 && xdotool key BackSpace ;\
	aether window size 1080x1690 . window snap center

class="foliate"
	ZEPHYR_TRACE=1 aether rule foliate

