# ........................................................................ audio

class="audacious"
	aether window group $(aether group id "PLAY") . window snap center

# delay for pavucontrol/pipewire sync SEE: pulse

class="pavucontrol"
	ZEPHYR_TRACE=1 aether rule pavucontrol

# ........................................................................ media

class="asunder"
	aether window group $(aether group id "UTIL")                                                            ;\
	[ -e /tmp/rulerrc:asunder ] && borealis window stack cycle || aether window size 1/3 . window snap center ;\
	touch /tmp/rulerrc:asunder

class="calibre"
	ZEPHYR_TRACE=1 aether rule calibre

class="nicotine"
	ZEPHYR_TRACE=1 aether rule nicotine

