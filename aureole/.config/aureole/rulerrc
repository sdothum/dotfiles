# ......................................................................... mail

class="aerc"
	ZEPHYR_TRACE=1 aether rule aerc ;\
	sleep 1 && xdotool type ':vsplit' && xdotool key Return

# open compose window but raise aerc to complete to/subject fields

class="email"
	aether window tile 3 2 . window group $(aether group id "COMM") ;\
	borealis window stack cycle

class="compose"
	aether window tile 3 2 . window group $(aether group id "COMM")

