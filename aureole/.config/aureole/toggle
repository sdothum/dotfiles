# sdothum - 2016 (c) wtfpl
[ $TRACE ] && CHILD="toggle $@" . $PARENT

# Cirrus
# ══════════════════════════════════════════════════════════════════════════════

# ............................................................ Toggle operations

# Usage: toggle [<msg>] SEE: functions/toggle

msg=$1
[ $msg ] && shift || usage $0
if [ -e ${0%/toggle}/functions/toggle/$msg ] ;then
	. ${0%/toggle}/functions/toggle/$msg $@
elif [ $(aether window count --all "$1") -gt 0 ] ;then
	winid=$(borealis window ids "$msg" | head -1)
	[ -n "$winid" ] && borealis window hide "$winid" || borealis window focus $(borealis window ids --all "$msg" | head -1)
else
	$@
fi

