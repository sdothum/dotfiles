# ............................................................. Group operations

# Usage: group <msg> [<name> | <group>] SEE: functions/group
#              where, 0-9     -> group focus <msg>
#                     -1/+1   -> group focus <msg> (relative)

# NOTE: sirocco group handling deficiencies (quirks) and extensions are handled here
# NOTE: group activation leaves stack/focus restoration to this workflow layer

GROUPS="VOID DESK COMM CODE WIKI UTIL PLAY PEER ''"                 # '' end of groups

name() {
	value=$(echo "$GROUPS" | cut -d' ' -f${1:-1})
	[ -n "$value" ] && printf '%s\n' "$value" || printf 'GROUP %s\n' "${1:-0}"
}
id()   { echo "$GROUPS" | tr ' ' '\n' | grep -n $1 | cut -d: -f1; }  # NOTE: assumes only valid script calls SEE: rulerrc!

CURRENT=$GROUP/current
LAST=$GROUP/last

read_current() {
	[ -d "$CURRENT" ] || return 1

	count=0
	candidate=
	invalid=
	for path in "$CURRENT"/* "$CURRENT"/.[!.]* "$CURRENT"/..?* ;do
		[ -e "$path" ] || [ -L "$path" ] || continue
		if [ -L "$path" ] || [ ! -d "$path" ] ;then
			invalid=1
			continue
		fi
		count=$((count + 1))
		candidate=${path##*/}
	done

	[ -z "$invalid" ] && [ "$count" -eq 1 ] || return 1
	case "$candidate" in
		''|*[!0-9]*) return 1 ;;
	esac
	tagcount=$(sirocco group count 2>/dev/null) || return 1
	[ "$candidate" -ge 0 ] && [ "$candidate" -lt "$tagcount" ] || return 1
	printf '%s\n' "$candidate"
}

current() {
	# GROUP/current is an observation owned by zephyrd; policy actions
	# change the WM and the daemon publishes the resulting mirror.
	read_current
}

plus() {
	group=$(( $(ls -1 $CURRENT) + $1 ))
	tagcount=$(group count)
	if [ $group -ge $tagcount ] ;then
		group=1
	elif [ $group -lt 1 ] ;then
		group=$((tagcount - 1))
	fi
	echo $group
}

msg=$1
case $msg in
	''      ) read_current ;;
	current ) read_current ;;  # nim syntax
	count   ) sirocco group count ;;
	id      ) id   $2 ;;
	name    ) name $2 ;;
	[1-9]   ) group focus $1 ;;          # SEE: query group and rulerrc
	-* | +* ) group focus $(plus $1) ;;  # -1/+1
	*       )
		shift
		if [ -e $(dirname $0)/functions/group/$msg ] ;then
			. $(dirname $0)/functions/group/$msg $@
		else
			usage $0 $msg
		fi
esac

