#!/usr/bin/bash
# sdothum - 2016 (c) wtfpl
[ $TRACE ] && CHILD="bin/aurora $@" . $PARENT

# Cirrus
# ══════════════════════════════════════════════════════════════════════════════

# ................................................................. Tweak layout

# Usage: aurora [-verbose]

# NOTE: panel is lost on exit, cause unknown (cirrusrc?) SEE: abbreviations.fish for usage fix (respawn)

THEMES="ui/themes"
verbose=$1

usage() {
	themes="$(recipe $THEMES | grep -v '^-' | tr '\n' ' ')"
	echo "$(basename $0) [-verbose]
> ${BROWN}Note: ${cyan}corner length 0% == full length of both sides (versus % of short side)
> <return> to exit" | usage:
}

# SEE: cirrusrc
snapshot() {
	enable_borders=$(recipe ui/enable_borders)
	border_style=$(recipe ui/border_style)
	outer_border_width=$(recipe ui/outer_border_width)
	inner_border_width=$(recipe ui/inner_border_width)
	corner_percent=$(recipe ui/corner_percent)
	corner_mask=$(recipe ui/corner_mask)
	outer_color_focused=$(recipe ui/outer_color_focused)
	outer_color_unfocused=$(recipe ui/outer_color_unfocused)
	inner_color_focused=$(recipe ui/inner_color_focused)
	inner_color_unfocused=$(recipe ui/inner_color_unfocused)
	gap_width_top=$(recipe 'ui/gap_width top')
	gap_width_bottom=$(recipe 'ui/gap_width bottom')
	gap_width_left=$(recipe 'ui/gap_width left')
	gap_width_right=$(recipe 'ui/gap_width right')
	grid_gap_width=$(recipe ui/grid_gap_width)
	panel_height=$(recipe panel/height)
	panel_indent=$(recipe panel/indent)
}

recover() {
	recipe ui/enable_borders $enable_borders
	recipe ui/border_style $border_style
	recipe ui/outer_border_width $outer_border_width
	recipe ui/inner_border_width $inner_border_width
	recipe ui/corner_percent $corner_percent
	recipe ui/corner_mask $corner_mask
	recipe ui/outer_color_focused $outer_color_focused
	recipe ui/outer_color_unfocused $outer_color_unfocused
	recipe ui/inner_color_focused $inner_color_focused
	recipe ui/inner_color_unfocused $inner_color_unfocused
	recipe 'ui/gap_width top' $gap_width_top
	recipe 'ui/gap_width bottom' $gap_width_bottom
	recipe 'ui/gap_width left' $gap_width_left
	recipe 'ui/gap_width right' $gap_width_right
	recipe ui/grid_gap_width $grid_gap_width
	recipe panel/height $panel_height
	recipe panel/indent $panel_indent

	config
}

settings() {
	themes="$(recipe $THEMES | grep -v '^-' | tr '\n' ' ')"
	echo "
	${ORANGE}T${cyan}heme                    "${NOCOLOR}${theme:----} \ \ ${brown}L${cyan}oad \| ${brown}S${cyan}ave as \| ${brown}D${cyan}elete  ${BROWN}${themes}"
	${ORANGE}!${cyan} borders                "${NOCOLOR}$(recipe ui/enable_borders)"
	${cyan}border ${ORANGE}s${cyan}tyle             "${NOCOLOR}$(decoration $(recipe ui/border_style)) \ \ ${brown}f${cyan}rame \| ${brown}l${cyan}eft \| ${brown}t${cyan}op \| ${brown}r${cyan}ight \| ${brown}b${cyan}ottom \| ${brown}c${cyan}orners [\<${BROWN}mask${cyan}\>]"
	${cyan}outer border ${ORANGE}w${cyan}idth       "${NOCOLOR}$(recipe ui/outer_border_width)"
	${cyan}inner border ${ORANGE}W${cyan}idth       "${NOCOLOR}$(recipe ui/inner_border_width)"
	${cyan}corner length ${ORANGE}%${cyan}          "${NOCOLOR}$(recipe ui/corner_percent)"
	${ORANGE}c${cyan}orners mask             "${NOCOLOR}$(map) \ \ \ \ \ \ ${cyan}\<${BROWN}xxxx${cyan}\> bit 1 \(on\) 0 \(off\) topleft .. bottomleft, 0000 == disable${cyan}"
	${cyan}outer color ${ORANGE}f${cyan}ocused      "${NOCOLOR}$(recipe ui/outer_color_focused) \ \ \<${BROWN}aarrggbb${cyan}\>"
	${cyan}outer color ${ORANGE}u${cyan}nfocused    "${NOCOLOR}$(recipe ui/outer_color_unfocused)"
	${cyan}inner color ${ORANGE}F${cyan}ocused      "${NOCOLOR}$(recipe ui/inner_color_focused)"
	${cyan}inner color ${ORANGE}U${cyan}nfocused    "${NOCOLOR}$(recipe ui/inner_color_unfocused)"
	${cyan}gap width ${ORANGE}t${cyan}op            "${NOCOLOR}$(recipe 'ui/gap_width top')"
	${cyan}gap width ${ORANGE}b${cyan}ottom         "${NOCOLOR}$(recipe 'ui/gap_width bottom')"
	${cyan}gap width ${ORANGE}l${cyan}eft           "${NOCOLOR}$(recipe 'ui/gap_width left')"
	${cyan}gap width ${ORANGE}r${cyan}ight          "${NOCOLOR}$(recipe 'ui/gap_width right')"
	${ORANGE}g${cyan}rid gap spacing         "${NOCOLOR}$(recipe ui/grid_gap_width)"
	${cyan}panel ${ORANGE}h${cyan}eight             "${NOCOLOR}$(recipe panel/height)"
	${cyan}panel ${ORANGE}i${cyan}ndent             "${NOCOLOR}$(recipe panel/indent)"
"
}

usage
snapshot
theme="$(recipe $THEMES/---)"  # last saved "base" theme NOTE: may NOT have been kept (updated)

config() {
	cirrusrc refresh
	[ $panel ] && { pkill -f 'draw panel'; draw panel; }
	return 0
}

color() { pastel format hex $value >/dev/null 2>&1; }
map()   { printf '%04d\n' $(echo "obase=2; $(recipe ui/corner_mask)" | bc); }
# theme() { [ $value ] || return 1; }

mask()  {
	[ $(echo "${#1}") -gt 4 ] && return 1
	m=$((2#$(echo ${1}0000 | sed 's/[^0]/1/g' | cut -c1-4)))
	printf '%d\n' "$m"
}

style() {
	case $1 in
		'' ) [ $theme ] || return 1 ;;
		f  ) value=0  ;;
		l  ) value=1  ;;
		t  ) value=2  ;;
		r  ) value=3  ;;
		b  ) value=4  ;;
		c  ) value=5; [ $2 ] && mask=$(mask $2) || return 0 ;;
		*  ) return 1 ;;
	esac
}

decoration() {
	case $1 in
		0   ) echo frame  ;;
		1   ) echo left   ;;
		2   ) echo top    ;;
		3   ) echo right  ;;
		4   ) echo bottom ;;
		# 5 ) echo "corners $(map)" ;;
		5   ) echo "corners" ;;
	esac
}

delete() { recipe -q "$THEMES/$1" && rm -r $WMSESSION/$THEMES/$1; }

load() {
	theme="${1-:$theme}"
	recipe -q "$THEMES/$theme"
	find $WMSESSION/$THEMES/$theme -maxdepth 1 >/tmp/cirrus:aurora 2>/dev/null
	[ -n "$(cat /tmp/cirrus:aurora)" ] || return 1
	while read attr <&3 ;do
		[ "${attr##*/}" = "$theme" ] && continue
		recipe -d "ui/${attr##*$theme/}"
		cp -r "$attr" $WMSESSION/ui/
	done 3< /tmp/cirrus:aurora
}

save()  {
	theme="${1-:$theme}"
	recipe -d "$THEMES/$theme"
	find $WMSESSION/ui -maxdepth 1 >/tmp/cirrus:aurora
	recipe -a "$THEMES/$theme"
	while read attr <&3 ;do
		echo "${attr##*/}" | grep -Eq 'ui|theme' && continue
		cp -r "$attr" $WMSESSION/$THEMES/$theme/
	done 3< /tmp/cirrus:aurora
}

while : ;do
	[ "$msg" ] && { ditto theme "$msg"; unset msg; }
	settings
	unset panel

	if [ $verbose ] ;then
		stty -echo
		stty cbreak
		IFS= read -p '> ' -n1 attr
		stty sane
		[ "$attr" ] || break

		case $attr in
			L | T ) echo -n Load theme ;;
			S     ) echo -n Save as theme ;;
			D     ) echo -n Delete theme ;;
			!     ) echo -n toggle borders ;;
			s     ) echo -n border style ;;
			w     ) echo -n outer border width ;;
			W     ) echo -n inner border width ;;
			%     ) echo -n corners percent ;;
			c     ) echo -n corners mask ;;
			f     ) echo -n focused aarrggbb ;;
			u     ) echo -n unfocused aarrggbb ;;
			F     ) echo -n inner focused aarrggbb ;;
			U     ) echo -n inner unfocused aarrggbb ;;
			t     ) echo -n gap width top ;;
			b     ) echo -n gap width bottom ;;
			l     ) echo -n gap width left ;;
			r     ) echo -n gap width right ;;
			g     ) echo -n grid gap spacing ;;
			h     ) echo -n panel height ;;
			i     ) echo -n panel indent ;;
			*     ) usage; continue ;;
		esac

		read -p ' ' value option
	else
		read -p '> ' attr value option
		[ "$attr" ] || break
	fi

	case $attr in
		L | T ) [ "$value" ] || [ "$theme" ] || { usage; continue; } ;;
		S     ) [ "$value" ] || [ "$theme" ] || { usage; continue; } ;;
		D     ) [ "$value" ] || [ "$theme" ] || { usage; continue; } ;;
		!     ) [ $(recipe ui/enable_borders) = 'true' ] && value=false || value=true ;;
		s     ) style $value $option || { usage; continue; } ;;
		c     ) mask=$(mask $value)  || { usage; continue; } ;;
		f     ) color $value || { usage; continue; } ;;
		u     ) color $value || { usage; continue; } ;;
		F     ) color $value || { usage; continue; } ;;
		U     ) color $value || { usage; continue; } ;;
		*     ) echo $value | grep -q '[^0-9]' && { usage; continue; } ;;
	esac

	case $attr in
		L | T ) load   ${value:-$theme} || msg="$theme not found" ;;
		S     ) save   ${value:-$theme} ;;
		D     ) delete ${value:-$theme} ;;
		!     ) recipe ui/enable_borders $value ;;
		s     ) recipe ui/border_style $value; [ $mask ] && recipe ui/corner_mask $mask ;;
		w     ) recipe ui/outer_border_width $value ;;
		W     ) recipe ui/inner_border_width $value ;;
		%     ) recipe ui/corner_percent $value ;;
		c     ) recipe ui/corner_mask $mask ;;
		f     ) recipe ui/outer_color_focused $value ;;
		u     ) recipe ui/outer_color_unfocused $value ;;
		F     ) recipe ui/inner_color_focused $value ;;
		U     ) recipe ui/inner_color_unfocused $value ;;
		t     ) recipe 'ui/gap_width top' $value; recipe 'ui/gap_width bottom' $value ;;  # NOTE: sets balanced margins by default
		b     ) recipe 'ui/gap_width bottom' $value ;;
		l     ) recipe 'ui/gap_width left' $value; recipe 'ui/gap_width right' $value ;;
		r     ) recipe 'ui/gap_width right' $value ;;
		g     ) recipe ui/grid_gap_width $value ;;
		h     ) recipe panel/height $value; panel=true ;;
		i     ) recipe panel/indent $value; panel=true ;;
		*     ) usage; continue ;;
	esac

	config
done

ifyes 'keep settings' || { recover; exit; }
ditto $(basename $0) "current settings saved"
recipe -d "$THEMES/---"
[ "$theme" ] && recipe -a "$THEMES/---/$theme"

# kak: filetype=sh
