#!/usr/bin/dash
# sdothum - 2016 (c) wtfpl
[ $TRACE ] && CHILD="cbonsai $@" . $PARENT

# Cirrus
# ══════════════════════════════════════════════════════════════════════════════

# ................................................................ blackboard ui

# Usage: blackboard on | off | toggle | hide (statusbars)

BLACKBOARD="blackboard/contrast"
THEME="theme/contrast"

hide() {
	recipe -t $BLACKBOARD || return 0
	for i in $(recipe blackboard/hide) ;do statusbar windowunmap $i ;done
}

case $1 in
	on   )
		recipe -r $BLACKBOARD/$(recipe $THEME)
		draw root color 000000
		[ $(recipe $THEME) != 'light' ] && invert_panel
		# killall -q lemonbar
		hide || statusbar windowunmap
		cirrusrc blackboard  # SEE: sxhkdrc "monocle"
		;;
	off  )
		recipe -t $BLACKBOARD && [ $(recipe $BLACKBOARD) != $(recipe $THEME) ] && invert_panel
		recipe -d $BLACKBOARD
		draw root
		cirrusrc refresh
		statusbar windowmap
		;;
	hide ) hide ;;
	*    ) recipe -t $BLACKBOARD && exec blackboard off || exec blackboard on ;;
esac

# kak: filetype=sh
