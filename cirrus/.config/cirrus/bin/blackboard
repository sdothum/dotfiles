#!/usr/bin/dash
# sdothum - 2016 (c) wtfpl
[ $TRACE ] && CHILD="cbonsai $@" . $PARENT

# Cirrus
# ══════════════════════════════════════════════════════════════════════════════

# ................................................................ blackboard ui

# Usage: blackboard on | off | toggle

statusbar() { for i in $(pgrep -a 'lemonbar' | cut -d' ' -f5) ;do xdotool search -name "$i" $1 ;done; }

case $1 in
	on  )
		recipe -r blackboard/contrast/$(recipe theme/contrast)
		draw root color 000000
		# killall -q lemonbar
		statusbar windowunmap
		cirrusrc blackboard  # SEE: sxhkdrc "monocle"
		;;
	off )
		recipe -t blackboard && [ $(recipe blackboard/contrast) != $(recipe theme/contrast) ] && invert_panel
		recipe -d blackboard
		draw root
		pgrep -f 'draw -- musc' >/dev/null && statusbar windowmap || draw panel
		cirrusrc refresh
		;;
	*   )
		recipe -t blackboard && exec blackboard off || exec blackboard on
		;;
esac

# kak: filetype=sh
