class="audacious"
	zephyr window group $(zephyr group id "PLAY") . window snap center

# delay for pavucontrol/pipewire sync SEE: pulse

class="pavucontrol"
	ZEPHYR_TRACE=1 zephyr rule pavucontrol

# ........................................................................ media

class="asunder"
	zephyr window group $(zephyr group id "UTIL")                                                            ;\
	[ -e /tmp/rulerrc:asunder ] && sirocco window stack cycle || zephyr window size 1/3 . window snap center ;\
	touch /tmp/rulerrc:asunder

