# ......................................................................... mail

class="aerc"
	ZEPHYR_TRACE=1 zephyr rule aerc ;\
	sleep 1 && xdotool type ':vsplit' && xdotool key Return

# open compose window but raise aerc to complete to/subject fields

class="email"
	zephyr window tile 3 2 . window group $(zephyr group id "COMM") ;\
	sirocco window stack cycle

class="compose"
	zephyr window tile 3 2 . window group $(zephyr group id "COMM")

