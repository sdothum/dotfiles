# Make_install
# ══════════════════════════════════════════════════════════════════════════════

# ................................................................ chimera-dinit

CHIMERA=$HOME/stow/dinit/etc/dinit.d.@chimera

sudo xbps-install -y libkmod-devel libcap-devel console-setup

cd /home/depot
exists --repo dinit-chimera || git clone https://github.com/chimera-linux/dinit-chimera.git

cd dinit-chimera
meson setup build
sudo ninja -C build install

# update void (glibc) services
# sudo cp -v $CHIMERA/early/scripts/* /usr/lib/dinit.d/early/scripts/

exit_zero() {
	sudo sed -i "1aexit 0  # NOTE: disabled for this Voidlinux installation" /usr/lib/dinit.d/early/scripts/$1
}

exit_zero tmpfiles.sh
exit_zero binfmt.sh

# udev
echo -e "#!/bin/sh

case "\$1" in
\tstart   ) /usr/bin/udevd --daemon      ;;
\tstop    ) udevadm control -e           ;;
\tsettle  ) udevadm settle               ;;
\ttrigger ) udevadm trigger --action=add ;;
esac
" | sudo tee /usr/lib/dinit.d/early/scripts/dev.sh

# logfile rotation
echo -e "/var/log/dinit.d/*.log {
\tcompress
\trotate 4
\tweekly
\tmissingok
\tnotifempty
}

$HOME/.local/state/dinit.d/log/*.log {
\tcompress
\trotate 4
\tweekly
\tmissingok
\tnotifempty
}
" | sudo tee /etc/logrotate.d/dinit.logrotate

sudo mkdir -p /var/log/dinit.d
mkdir $HOME/.local/state/dinit.d/log

# cosmetic init message cleanup
sudo sed -i '/^echo "Checking root file system/s/^/# /; /^fsck -C/s,$, >/dev/null,' /usr/lib/dinit.d/early/scripts/root-fsck.sh
sudo sed -i '/^fsck -A -R -C/s,$, >/dev/null,' /usr/lib/dinit.d/early/scripts/fs-fsck.sh

# backup dinit "init"
sudo cp -v /sbin/init /sbin/init.@dinit

[ -e ${CHIMERA#*dinit} ] && exit

sudo cp -rv $CHIMERA /etc
sudo rm /etc/dinit.d
sudo ln -s ${CHIMERA#*dinit} /etc/dinit.d
sudo cp -v /bin/dinit /bin/dinit.chimera

# handle rare early-fs-fstab btrfs availability SEE: /etc/dinit.d/early-fs-fstab.target
echo "#!/bin/sh
#
# NOTE: Trap rare btrfs subvol availability/timing issue with simple retry

mount_fstab()
{
	mount -a -t "nosysfs,nonfs,nonfs4,nosmbfs,nocifs" -O no_netdev
}

mount_fstab && exit 0

echo "early-fs-fstab: mount failed; retrying in 1 second" >&2
sleep 1
mount_fstab && exit 0

echo "early-fs-fstab: mount failed again; retrying in 2 seconds" >&2
sleep 2

exec mount -a -t "nosysfs,nonfs,nonfs4,nosmbfs,nocifs" -O no_netdev

# kak: filetype=sh
" >/usr/local/libexec/fs-fstab-retry

sudo chmod 755 /usr/local/libexec/fs-fstab-retry

# kak: filetype=sh
