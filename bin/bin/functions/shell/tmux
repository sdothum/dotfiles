# ................................................................. tmux session

usage() { usage: "$(basename $0) [session [class=<class>] [name [command]]* | c'apture (tmux:report) | selec't (clipboard) | e'dit]"; exit 1; }

CMD=/usr/bin/tmux
CAPTURE=/tmp/tmux:capture-$(rand 4).txt
REPORT=/tmp/tmux:report
TMUXCONF=${TMUXCONF:-$HOME/.tmux.conf}

# NOTE: command keys optimized for chatgpt codex iterations SEE: tmux.conf for C-k/C-t keybyinds

case $1 in
	session )
		shift
		[ "${1#class=}" != "$1" ] && { class=${1#class=}; shift; }
		[ $1   ] && { export TMUX=$1; shift; } || export TMUX=tmux
		[ "$1" = aerc ] && export MONOFONT=Iosevka-proof

		if $CMD -S /tmp/tmux:$TMUX has-session 2>/dev/null ;then
			term ${TMUX} class=${class:-tmux} $CMD -S /tmp/tmux:$TMUX attach -d
		else
			term ${TMUX} class=${class:-tmux} "FORTUNE=$TMUX" $CMD -f $TMUXCONF -S /tmp/tmux:$TMUX "new-session -n ° $@"
		fi
		;;
	c       ) $CMD capture-pane -p -S - >$REPORT; notify tmux "$(wc -l $REPORT)" ;;
	t       ) $CMD capture-pane -p -S - | xclip -selection clipboard  ;;
	e       ) $CMD capture-pane -p -S - >$CAPTURE; kak $CAPTURE ;;
	-h      ) usage ;;
	*       ) $CMD $@ ;;
esac

