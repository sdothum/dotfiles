# Hardware
# ══════════════════════════════════════════════════════════════════════════════

# .......................................................................... CPU

# Usage: cpu_watch [<5GHz range>], default 5.5GHz and above

clear
# watch -fn 0.1 "grep MHz /proc/cpuinfo | sort -nr | grep ' 5[${1:-5}-9]'"
TERM=xterm-256color watch -c -fn 0.1 "grep MHz /proc/cpuinfo | sort -nr | grep ' 5[${1:-5}-9]' | sed 's/[^0-9]*\(.\)\([^.]*\).*/\tcpu   \1.\2 ɢʜz/; /5.6/s/5.*/${cyan}&${NOCOLOR}/; /5.7/s/5.*/${yellow}&${NOCOLOR}/; /5.8/s/5.*/${GREEN}&${NOCOLOR}/; /5.9/s/5.*/${MAGENTA}&${NOCOLOR}/'"

