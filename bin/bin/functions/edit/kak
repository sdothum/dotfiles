usage() { echo "[kmd=<command>] $(basename $0) [-l'ist | -k'ill [<id>] | -d'ebug [<debug>] | -v'ersion | -h'elp]
> [-BENCHMARK | -LEXICON | -PROOF | -TRACE | -UNPLUG | -CONSOLE | -TUI | -TRIM | -CROSSHAIRS | RULER=<char>]
> [-- | ID=<id>] [WAIT] [<row>x<col>]
> <file>*
> where, <debug> is [hooks|shell|profile|keys|commands]" | usage:
	exit 1
}

# NOTE: $kmd is passed passively to (env) term for subsequent "xdotool type"

headless=${headless:-false}
echo $1 | grep -q '.*/yazi-.*/bulk-.*' && yazi=true  # FOR: attached yazi bulk renames
# share all instances (clients) with a single kak server session
ID=${ID:-$USER}  # default session id

[ -e $SESSION/kak:ruler ] && export RULER=$(cat $SESSION/kak:ruler)
[ "$BG" ] || { [ -e $SESSION/kak:bg ] && export BG=$(cat $SESSION/kak:bg); }
export TABSTOP=3      # default for (pipe), SEE: align

[ -e /usr/local/bin/kak ] && KAK=/usr/local/bin/kak || KAK=/usr/bin/kak
$KAK -l | grep -q dead | $KAK -clear  # dead sessions

debug() {
	if echo "$1" | grep -qE 'hooks|shell|profile|keys|commands' ;then
		debug="-debug $1"
	else
		debug="-debug commands"
		false
	fi
	}

while : ;do
	case $1 in
		*[0-9]x[0-9]* ) XY=$1   ;;
		--            ) ID=$(rand)    ;;                # force new instance
		-BENCH*       ) hyperfine -warmup 10 "$KAK -ui dummy -e quit"; exit ;;
		-CONSOLE      ) unset DISPLAY; console=true; export COLORSCHEME=${COLORSCHEME:-default} ;;
		-CROSSHAIRS   ) export CROSSHAIRS=true ;;
		-d            ) export TRACE=/tmp/kak:trace; debug $2 && shift ;;  # debug trace
		-h* | help    ) $KAK -help; usage ;;
		id=*          ) ID="${1#*=}"  ;;
		ID=*          ) ID="${1#*=}"  ;;
		-k            ) [ $2 ] && $KAK -p $2 || { for i in $($KAK -l); do ditto kak "$i ${RED}❌"; echo kill | $KAK -p $i ;done; pkill kak-lsp; }; exit ;;
		-l            ) $KAK -l; exit ;;
		-LEXICON      ) DICTIONARY=$HOME/.config/kak-lsp/kak-lsp:dictionary; reverse=-r ;;  # push .config dictionary to end of sort list
		-PROOF        ) export MONOFONT="Iosevka-proof"; export BG="${BG:-ffead0:-7,fff5e8:-7,96f8f8:-12,fa8c69}" ;;
		RULER=*       ) export RULER="${1#*=}" ;;       # default RULER='│'
		-TRACE        ) export TRACE=/tmp/kak:trace ;;  # trace messages
		-TRIM         ) export TRIM=NormalIdle ;;       # BufWritePre default blank line trimming
		-TUI          ) export KAKTUI=true ;;           # avoid resetting term bg on exit (for kak within ncurses panel)
		-UNPLUG       ) export UNPLUG=true ;;           # kakrc plugins exclusions
		-v*           ) $KAK -version; exit ;;
		WAIT          ) WAIT=$1 ;;
		*             ) break   ;;
	esac
	shift
done

echo $@ | grep -q '\.nim' >/dev/null && export CROSSHAIRS=true  # BECAUSE: nim uses 2 space indentation
pgrep aurora >/dev/null && export KAKTUI=true                   # FOR: visual gap/margin tweaking

# remove dangling lsp service state
pgrep kak-lsp >/dev/null || rm -rf /run/user/$(id -u)/kakoune-lsp/${USER}*

# escape filenames containing spaces
count=0
IFS=$(echo)  # to handle space filename parsing
for i in $@ ;do
	grep -q '^#.*filetype=sh' "$i"         && ID=script
	echo "$i" | grep -Eq '(^kakrc|\.kak)$' && ID=kakoune
	files=$(printf "%s\n%s" "$i" "$files")
	count=$(( count + 1 ))
done

[ $count -gt 1 ] && notify low 'Kakoune' "$count files to edit"
# snapshot sources (in lieu of persistent undo avalability)
console || (printf "$files" | xargs -r -d'\n' hgadd) &

# client/server
if $headless ;then
	$KAK -l | grep -q $ID || setsid $KAK -d -s $ID &
else
	$KAK -l | grep -q $ID || session='-s'
fi

[ $yazi ] && exec $KAK $files  # NOTE: attached yazi session only issues 1 file (??) spawning via xargs causes desktop windowing issues
if console || [ $console ] ;then
	printf "$files" | sort $reverse | xargs -d'\n' $KAK -e 'db *stdin*'
	exit  # NOTE: "exec .. | .." (pipe) will not redirect shell, hence, "exit"
fi

title=$(echo "$1" | sed 's|\.\/||g; s| [^ ]*/||; s/ .*/.../g')
[ $count -gt 1 ] && title="$title($count)"
XARGS=$(mktemp --suffix=@kak)  # (??) mktemp TEMPLATE (eg kak-XXXXXX) is problematic
files=${files:-$(mktemp --suffix=:kak)}

# NOTE: kak -e 'db *stdin*' to remove *stdin* scratch buffer created by "xargs kak"

echo "#!/bin/dash
printf \"$files\" | sort $reverse | xargs -d'\\\n' $KAK -e 'db *stdin*' $debug ${session:--c} $ID
" >$XARGS
chmod 755 $XARGS

exec term "title=kak:$title" class=${class:-kak} PAPER ${XY:-132x52} $WAIT $XARGS  # NOTE: exec for pwait pattern match

