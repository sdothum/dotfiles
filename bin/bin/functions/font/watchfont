# .............................................................. Watchface fonts

usage() { echo "$(basename $0) [-b] n'umerals | d'ate <fontsize}" | usage:
	exit 1
}

# Garmin watchface project fonts
# NOTE: rotated numerals 4 & 8 require *.fnt adjustment of xoffset/xadvance etc. depending on fontsize

WATCHFACE=$HOME/.local/share/fonts/watchface
GARMIN=$STOW/garmin
FONTS=resources/fonts
WEIGHT=book  # dial numerals

[ "$1" = -b ] && { WEIGHT=bold; shift; }

[ $2 ] || usage
fontsize=$2
cd $WATCHFACE

# utf decimal "0u9999"
utf() { printf "$1" | iconv -t UTF16LE | od -t x2 -An -v | sed 's/ /\u/g; s/^/0u/'; }

rotate() {
	echo "
Open(\"watchface-normal${WEIGHT}upright.ttf\");
Select($(utf $1));
Rotate($2);
Generate(\"$3\");
" >/tmp/garminfont.script

fontforge -quiet --script /tmp/garminfont.script
}

case $1 in
	n* )
		rotate '4' +60 four.ttf
		fontbm \
			--font-file four.ttf                        \
			--font-size ${fontsize}                     \
			--chars '52'                                \
			--output four_${fontsize}

		rotate '8' -60 eight.ttf
		fontbm                                         \
			--font-file eight.ttf                       \
			--font-size ${fontsize}                     \
			--chars '56'                                \
			--output eight_${fontsize}

		fontbm                                         \
			--font-file watchface-normal${WEIGHT}upright.ttf \
			--font-size ${fontsize}                     \
			--chars '49,50'                             \
			--output twelve_${fontsize}
		;;
	d* )
		fontbm                                         \
			--font-file watchface-normalbookupright.ttf \
			--font-size ${fontsize}                     \
			--chars '32,48-57,70,77,83,84,87,97,100,101,104,105,110,111,114,116,117' \
			--output date_${fontsize}
		;;
	*  ) usage
esac

for i in $GARMIN/* ;do
	for f in *_${fontsize}.fnt *_${fontsize}_0.png ;do
		[ -e "$f" ] && mv -v ${i}/$FONTS/$f ${i}/$FONTS/$f.bak
		cp -v $f ${i}/$FONTS/$f
	done
	case $1 in
		n* ) for n in four eight twelve ;do sed -i "/${n}/s/_[0-9]*/_${fontsize}/" ${i}/$FONTS/fonts.xml ;done ;;
		d* ) sed -i "/date/s/_[0-9]*/_${fontsize}/" ${i}/$FONTS/fonts.xml ;;
	esac
done
