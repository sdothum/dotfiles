[ $TRACE ] && CHILD="window/shift $@" . $PARENT

# Windowchef
# ══════════════════════════════════════════════════════════════════════════════

# .............................................................. Shift by window

# Usage: window shift left | right | up | down (of window edge)

set_geometry  # X Y WIDTH HEIGHT
snapshot_geometry

case $1 in
	left  ) waitron window move --relative -$(( WIDTH + border * 2 )) 0  ;;
	right ) waitron window move --relative  $(( WIDTH + border * 2 )) 0  ;;
	up    ) waitron window move --relative 0 -$(( HEIGHT + border * 2 )) ;;
	down  ) waitron window move --relative 0  $(( HEIGHT + border * 2 )) ;;
esac

waitron window focus $winid

