[ $TRACE ] && CHILD="window/desktop $@" . $PARENT

# Windowchef
# ══════════════════════════════════════════════════════════════════════════════

# ............................................................ Window to desktop

# Usage: window desktop <group> [teleport]

desktop=$(desktop)
waitron group remove
rmdir $GROUP/$desktop/$winid
waitron group add $1
mkdir -p $GROUP/$1/$winid
desktop add $1 $winid

# teleport and refocus to window's previous group
if [ $2 ] ;then
	W=$(ls -1 $GROUP/$desktop | head -1)
	[ $W ] && {
		desktop $desktop
		waitron window focus $W
		desktop add $desktop $W
		exit  # skip original window refocus SEE: window wrapper
	}
fi

