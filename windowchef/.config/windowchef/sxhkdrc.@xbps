super + {h,j,k,l}
	waitron window move --relative {-20 0, 0 20, 0 -20, 20 0}

super + alt + {h,j,k,l}
	waitron window resize --relative {-20 0, 0 20, 0 -20, 20 0}

super + shift + {h,j,k,l}
	waitron window move --relative {-50 0, 0 50, 0 -50, 50 0}

super + shift + alt + {h,j,k,l}
	waitron window resize --relative {-50 0, 0 50, 0 -50, 50 0}

alt + {h,j,k,l}
	waitron window focus --cardinal {left,down,up,right}

super + alt + Escape
	waitron wm quit 0

super + f
	waitron window maximize

super + w
	waitron window close

super + b
	waitron window maximize --horizontal

super + v
	waitron window maximize --vertical

super + m
	waitron window monocle

alt + Tab
	waitron window cycle

alt + shift + Tab
	waitron window cycle --reverse

alt + ctrl + Tab
	waitron window focus --last

super + {_,shift +}{1-9}
	waitron {group toggle,group add} {1-9}

super + ctrl + r
	waitron group remove

super + alt + ctrl + {1-4}
	waitron group remove --all {1-4}

super + Return
	xterm

super + {Insert,Prior,Delete,Next,End}
	waitron window_snap {topleft,topright,bottomleft,bottomright,middle}
