[ $TRACE ] && CHILD="window/group $@" . $PARENT

# Faouzia
# ══════════════════════════════════════════════════════════════════════════════

# .............................................................. Window to group

# Usage: window group <group> [teleport]

[ -e $GROUP/$1/$winid ] && return

group=$(group current)
rm -rf $GROUP/$group/$winid
sirocco group_remove_window
sirocco group_add_window $1
group add $1 $winid

# teleport and refocus to window's previous group
if [ $2 ] ;then
	W=$(ls -1 $GROUP/$group | head -1)
	[ $W ] && {
		group $group
		sirocco window_focus $W
		group add $group $W
		exit  # skip original window refocus SEE: window wrapper
	}
fi

