--langdef=kakoune
--langmap=kakoune:.kak
--regex-kakoune=/^.*define-command[ \t]+([^ ]*)/\1/c,command/
--regex-kakoune=/^.*bundle[ \t]+([^ ]*)/\1/b,bundle/
--regex-kakoune=/^.*declare-option[ \t]+([^ ]*)/\1/o,option/
--regex-kakoune=/^.*add-highlighter[ \t]+(-overrides)*[ \t]+([^ ]*)/\2/h,highlighter/
--regex-kakoune=/^.*set-face[ \t]+(global|window)*[ \t]+([^ ]*)/\2/f,face/

--langdef=nim
--langmap=nim:.nim
--regex-nim=/^[ \t]*(proc|macro|method|template|iterator|converter)[ \t]+([a-zA-Z0-9_]+)/\2/p,procedures/
--regex-nim=/^[ \t]*type[ \t]+([a-zA-Z0-9_]+)/\1/t,types/
--regex-nim=/^[ \t]*const[ \t]+([a-zA-Z0-9_]+)/\1/c,constants/
--regex-nim=/^[ \t]*var[ \t]+([a-zA-Z0-9_]+)/\1/v,variables/

